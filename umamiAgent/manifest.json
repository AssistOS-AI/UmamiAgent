{
  "container": "docker.io/assistos/umami-agent@sha256:346a68283a88129f10c56ac940929dafbbf12f9b7cece3169d11d6a9f359ec93",
  "lite-sandbox": true,
  "agent": "sh /code/scripts/start-umami-agent.sh",
  "readiness": {
    "protocol": "mcp"
  },
  "health": {
    "readiness": {
      "interval": 2,
      "timeout": 2,
      "failureThreshold": 75,
      "successThreshold": 1
    }
  },
  "routerAccess": {
    "requiredCapability": "explorer.access",
    "capabilityDeniedRedirect": "/base-agent-additional-server/userPersistoAgent/7000/service/dashboard/",
    "httpRoutes": [
      {
        "path": "/IDE-plugins/umami-settings/*",
        "access": "guest"
      },
      {
        "path": "/IDE-plugins/umami-tool-button/*",
        "access": "guest"
      },
      {
        "path": "/base-agent-additional-server/umamiAgent/3000/script.js",
        "access": "public"
      },
      {
        "path": "/base-agent-additional-server/umamiAgent/3000/api/send",
        "access": "public",
        "publicProtocol": {
          "methods": ["POST", "OPTIONS"],
          "allowCors": true,
          "allowHeaders": ["content-type", "x-umami-website-id", "x-umami-hostname", "x-umami-cache"]
        }
      }
    ]
  },
  "about": "Read-only Umami agent for AchillesIDE.",
  "endpoints": {
    "agent-card": {
      "name": "Umami Agent",
      "description": "Reads self-hosted Umami data through controlled MCP tools.",
      "tags": ["umami", "read-only"]
    }
  },
  "profiles": {
    "default": {
      "env": {
        "POSTGRES_DB": {
          "required": false,
          "default": "umami"
        },
        "POSTGRES_USER": {
          "required": false,
          "default": "admin"
        },
        "POSTGRES_PASSWORD": {
          "required": false,
          "default": "admin"
        },
        "APP_SECRET": {
          "name": "UMAMI_APP_SECRET",
          "required": true,
          "sharedGeneratedSecret": true
        },
        "UMAMI_BASE_URL": {
          "required": false,
          "default": "http://127.0.0.1:3000"
        },
        "UMAMI_INTERNAL_KEY_SEED": {
          "required": true,
          "generatedSecret": true
        },
        "UMAMI_ADMIN_PASSWORD": {
          "required": false
        },
        "UMAMI_SEED_WEBSITES": {
          "required": false
        },
        "UMAMI_DEFAULT_WEBSITE_ID": {
          "required": false
        },
        "UMAMI_TIMEZONE": {
          "required": false
        },
        "UMAMI_OUTPUT_DIR": {
          "required": false,
          "default": "/shared/deliverables/umami"
        }
      }
    }
  },
  "ideSettings": [
    {
      "key": "umami-settings",
      "label": "Umami Settings",
      "scope": "workspace",
      "pluginKey": "umamiAgent/umami-settings",
      "settingsComponent": "umami-settings",
      "adminOnly": false
    }
  ]
}
